# ============================================
# Docker Compose 环境变量
# 复制此文件为 .env 并填写真实值
# ============================================

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_DATABASE=deviceusagetime

# ---------- 邮件 ----------
EMAIL_SENDER=your_email@qq.com
EMAIL_PASSWORD=your_email_auth_code

# ---------- JWT ----------
JWT_SECRET=your_jwt_secret_key_change_me
JWT_EXPIRATION=86400000

# ---------- 宿主机端口映射（可选，有默认值） ----------
# 注意与容器内端口区分：容器内 Redis 固定为 6379，由 compose 显式注入
# MYSQL_PUBLISH_PORT=3306
# REDIS_PUBLISH_PORT=6379
# BACKEND_PUBLISH_PORT=8080
# FRONTEND_PUBLISH_PORT=80

# ---------- 前端域名（可选，Nginx server_name，留空/缺省为 _ 匹配所有 Host） ----------
# DOMAIN=primordialcode.xyz

# ---------- 后端地址（可选，Nginx 反向代理目标，默认 Docker 内部网络 backend:8080） ----------
# BACKEND_HOST=backend:8080
# BACKEND_UPSTREAM=backend

# ---------- 后端运行时（可选） ----------
# JVM 参数
# JAVA_OPTS=-Xms256m -Xmx512m
# 实时推送 broker：memory(单实例) / redis(多实例)
# REALTIME_BROKER=memory
# 跨域白名单（同域反代留空）
# CORS_ALLOWED_ORIGINS=