# ============================================
# Docker Compose 环境变量
# 复制此文件为 .env 并填写真实值
# ============================================

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=your_mysql_root_password

# ---------- 邮件 ----------
EMAIL_SENDER=your_email@qq.com
EMAIL_PASSWORD=your_email_auth_code

# ---------- JWT ----------
JWT_SECRET=your_jwt_secret_key_change_me
JWT_EXPIRATION=86400000

# ---------- 端口（可选，有默认值） ----------
# MYSQL_PORT=3306
# REDIS_PORT=6379
# BACKEND_PORT=8080
# FRONTEND_PORT=80

# ---------- 前端域名（可选，Nginx server_name） ----------
# DOMAIN=primordialcode.xyz

# ---------- 后端地址（可选，Nginx 反向代理目标，默认 Docker 内部网络 backend:8080） ----------
# BACKEND_HOST=backend:8080